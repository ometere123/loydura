{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "tests/**/*.ts"]
}
